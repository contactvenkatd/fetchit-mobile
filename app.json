{
  "expo": {
    "name": "fetchit-mobile",
    "slug": "fetchit-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fetchitmobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "ai.compreo.fetchit",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "development",
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.anonymous.fetchitmobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1A1A",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.ai.compreo.fetchit",
          "enableGooglePay": false
        }
      ],
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.120830719857-cut021t8gjpeha2fbb58pa89fdaunt29"
        }
      ],
      "./plugins/withSceneLifecycle",
      "./plugins/withGoogleSignIn",
      "./plugins/withPlayIntegrity",
      [
        "./plugins/withAppAttest",
        {
          "environment": "development"
        }
      ]
    ],
    "extra": {
      "playIntegrityCloudProjectNumber": "",
      "router": {},
      "eas": {
        "projectId": "cdbe685f-4a42-4078-8217-8c0e3489ed5a"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
